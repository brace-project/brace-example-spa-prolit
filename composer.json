{
  "name": "brace-project/brace-example-spa-prolit",
  "type": "project",
  "description": "Example SPA combining Brace on the backend with TrunkJS Prolit on the frontend.",
  "license": "MIT",
  "authors": [
    {
      "name": "Matthias Leuffen",
      "email": "leuffen@continue.de"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "brace/core": "*",
    "brace/mod-request-laminas": "*",
    "brace/mod-router": "*",
    "brace/mod-body": "*",
    "brace/mod-spaserve": "dev-feat/vite-auto-html-start-html"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/brace-project/brace-mod-spaserve"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app.be/src/"
    },
    "files": [
      "bootstrap.php"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^13.2.2"
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "preferred-install": "source",
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
