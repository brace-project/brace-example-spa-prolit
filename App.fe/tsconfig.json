{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["vite/client", "node"],
    "paths": {
      "@trunkjs/scope/runtime": ["node_modules/@trunkjs/scope/src/runtime.ts"],
      "@trunkjs/scope": ["node_modules/@trunkjs/scope/index.ts"],
      "@trunkjs/browser-utils": ["node_modules/@trunkjs/browser-utils/index.ts"],
      "@trunkjs/prolit-renderer": ["node_modules/@trunkjs/prolit-renderer/index.ts"],
      "@trunkjs/prolit": ["node_modules/@trunkjs/prolit/index.ts"],
      "@trunkjs/router": ["node_modules/@trunkjs/router/index.ts"],
      "@trunkjs/responsive": ["node_modules/@trunkjs/responsive/index.ts"],
      "@trunkjs/api-stub": ["node_modules/@trunkjs/api-stub/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
